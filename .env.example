PORT=5050
NODE_ENV=production

# Required to create the first local super administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
# Use a long, random secret. Do not change it after users register.
AADHAAR_PEPPER=

# Keep false except on a private development machine with NODE_ENV=development.
LOCAL_EMAIL_TEST_MODE=false
LOCAL_SMS_TEST_MODE=false

# Optional production verification delivery.
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional NASA FIRMS feed; NASA GIBS imagery does not require a key.
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA21_NRT
FIRMS_BBOX=60,20,98,38
